#!/usr/bin/env bash
# Start the claude-realms MCP server from a uv-managed environment kept in the
# plugin's data directory (never inside the plugin folder, which may be a
# read-only cache). uv resolves exactly the locked dependencies.
set -euo pipefail
root="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
fallback="${XDG_DATA_HOME:-$HOME/.local/share}/claude-realms"
data="${REALMS_HOME:-${CLAUDE_PLUGIN_DATA:-$fallback}}"
case "$data" in *'${'*|'') data="$fallback" ;; esac
export REALMS_HOME="$data"
mkdir -p "$data" && chmod 700 "$data"
uv=$(command -v uv || true)
if [ -z "$uv" ]; then
  # No uv on this machine: fetch it from PyPI once, into the data directory
  # (removed with the plugin), so installing the plugin is all it takes.
  # stdout is the MCP channel, so everything here reports on stderr.
  uv="$data/bin/uv"
  if [ ! -x "$uv" ]; then
    staging=$(mktemp -d "$data/.uv-XXXXXX")
    if python3 -m venv "$staging/env" >&2 &&
       "$staging/env/bin/python" -m pip install --quiet --disable-pip-version-check uv >&2; then
      mkdir -p "$data/bin" && cp "$staging/env/bin/uv" "$staging/uv" && mv -f "$staging/uv" "$uv"
    fi
    rm -rf "$staging"
  fi
  if [ ! -x "$uv" ]; then
    echo "claude-realms could not set up uv (needs python3 with venv and network access); install uv: https://docs.astral.sh/uv/" >&2
    exit 1
  fi
fi
export UV_PROJECT_ENVIRONMENT="$data/venv"
exec "$uv" run --project "$root" --frozen --no-dev --quiet python -P -m claude_realms.server
